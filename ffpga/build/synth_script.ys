read_verilog -sv "../src/carrier_generator.v" "../src/nec_decoder.v" "../src/nec_encoder.v" "../src/modulator.v"
hierarchy -check
flatten -noscopeinfo
synth_xilinx -nobram -noiopad -nodsp -abc9 
clean
autoname
write_verilog "post_synth_results.v"
write_edif "netlist.edif"
tee -q -o post_synth_report.txt stat